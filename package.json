{
  "name": "passo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Italian e-invoicing relay: CRM to SdI via pluggable channels",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/radioBros/passo#readme",
  "bugs": { "url": "https://github.com/radioBros/passo/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/radioBros/passo.git" },
  "keywords": ["fatturapa", "sdi", "e-invoicing", "italy", "einvoice"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "dev:api": "node --watch --experimental-strip-types src/api/server.ts",
    "cli": "node --experimental-strip-types src/cli/passo-cli.ts",
    "lint:fix": "eslint . --fix",
    "test:coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "stack:reset": "docker compose down -v && docker compose up -d --build",
    "mcp": "docker compose run --rm mcp",
    "gen:openapi": "node scripts/gen-openapi.mjs",
    "check:openapi": "node scripts/gen-openapi.mjs --check",
    "gen:sdi-errors": "node scripts/gen-sdi-errors.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "seed:dev": "node scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "amqplib": "^0.10.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "decimal.js": "^10.4.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "imapflow": "^1.7.7",
    "ioredis": "^5.4.1",
    "libxmljs2": "^0.37.0",
    "mailparser": "^3.9.33",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "rate-limiter-flexible": "^5.0.4",
    "undici": "^8.12.3",
    "xmlbuilder2": "^4.0.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vite": "^6.4.5",
    "proxy-addr": "2.0.8"
  }
}
