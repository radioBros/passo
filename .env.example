# PASSO configuration. Copy to .env and replace every CHANGE_ME.
# Boot validation runs BEFORE any connection opens, so a missing or malformed
# value fails loudly at startup rather than on the first invoice.

NODE_ENV=production
LOG_LEVEL=info

# ─── External ports ───────────────────────────────────────────────────────
# Every published port is configurable so the stack coexists with other work.
PASSO_PORT=3000
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
REDIS_PORT=6379

# Used to build trackingUrl in API responses. Never hardcode a vendor domain.
PASSO_BASE_URL=http://localhost:3000

# ─── Postgres ─────────────────────────────────────────────────────────────
POSTGRES_DB=passo
POSTGRES_USER=passo_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_admin_password

# Admin connection: used ONLY by the migrate service to apply schema and
# provision roles.
DATABASE_ADMIN_URL=postgres://passo_admin:CHANGE_ME_postgres_admin_password@postgres:5432/passo

# Runtime connection: least-privilege role, NOSUPERUSER NOBYPASSRLS. RLS applies
# to it, which is what makes tenant isolation real rather than advisory.
PASSO_DB_PASSWORD=CHANGE_ME_app_db_password
DATABASE_URL=postgres://passo_app:CHANGE_ME_app_db_password@postgres:5432/passo
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ─── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_USER=passo
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
RABBITMQ_URL=amqp://passo:CHANGE_ME_rabbitmq_password@rabbitmq:5672

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Admin credential ─────────────────────────────────────────────────────
# Bootstrap credential read at first boot. PASSO refuses to start without it
# and never generates or prints a default — a generated secret ends up in
# shell history and logs.
#   openssl rand -base64 32
PASSO_ADMIN_KEY=CHANGE_ME_admin_key_at_least_24_chars

# ─── Encryption ───────────────────────────────────────────────────────────
# 32 bytes, base64. Multiple versions may coexist so rotation can still
# decrypt historical rows.
#   openssl rand -base64 32
PASSO_ENCRYPTION_KEY_V1=CHANGE_ME_base64_32_bytes
PASSO_ENCRYPTION_KEY_ACTIVE=v1

# ─── Retention (stateless relay) ──────────────────────────────────────────
# PASSO keeps no invoice archive: the CRM is the system of record.
CORRELATION_RETENTION_DAYS=90
AUDIT_RETENTION_MONTHS=12
RECEIPT_ACK_GRACE_DAYS=7

# ─── API behaviour ────────────────────────────────────────────────────────
# Sync mode waits only for the transmitted (AT) milestone, never for RC/MC/DT:
# MC delivery retry runs for days, so no HTTP timeout can represent it.
SYNC_MAX_WAIT_MS=120000
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SEC=60

# ─── Rendering ────────────────────────────────────────────────────────────
# xsltproc runs as a subprocess; both limits bound untrusted input.
PASSO_RENDER_TIMEOUT_MS=10000
PASSO_MAX_RENDER_BYTES=8388608

# ─── PEC polling ──────────────────────────────────────────────────────────
# PEC is the only channel with no webhook, so receipts must be fetched.
PEC_POLL_INTERVAL_MS=60000
# OpenAPI.it receipts are also re-read by polling, in case a webhook is missed.
VENDOR_POLL_INTERVAL_MS=300000

# ─── Alerts (all optional) ───
# Problems that stop invoices (vendor out of credit, seller not registered, PEC
# mailbox unreadable) are emailed and/or posted to a webhook. See
# docs/operations/alerts.md. The SMTP server is a NORMAL outbox, not PEC; TLS is
# always required (465 implicit, otherwise STARTTLS).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_FROM=
# Receives every alert from every tenant, plus system alerts:
OPERATOR_ALERT_EMAIL=
OPERATOR_ALERT_WEBHOOK_URL=
OPERATOR_ALERT_WEBHOOK_SECRET=
ALERT_REPEAT_MINUTES=360

# ---- HTTP hardening -------------------------------------------------------
# CORS is OFF by default: PASSO is a server-to-server relay and a browser origin
# has no business holding a CRM's API key. Set an explicit comma-separated
# allowlist to opt in. A wildcard "*" combined with credentials is refused at boot.
PASSO_CORS_ORIGINS=
PASSO_CORS_CREDENTIALS=false
# HSTS max-age in seconds. 0 disables the header for plain-HTTP local dev.
PASSO_HSTS_MAX_AGE=31536000

# Local development ONLY: allows boot without the RabbitMQ delayed-message
# plugin, which turns retries into immediate redelivery. Never set in production.
# PASSO_ALLOW_NO_DELAYED_EXCHANGE=1
